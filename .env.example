PORT=3000
TRUST_PROXY=0
MONGODB_URI=mongodb://127.0.0.1:27017/stillroom
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional Redis URL for rate limits shared across PM2 cluster workers.
# Without Redis, rate limits are stored in memory separately per worker.
# REDIS_URL=redis://127.0.0.1:6379
AWS_REGION=us-east-1
S3_BUCKET=your-private-image-bucket
# Optional for local development; alternatively use an AWS profile or IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
