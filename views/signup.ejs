<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Create account · Stillroom</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="auth-page">
    <main class="auth-layout">
      <a class="brand" href="/login" aria-label="Stillroom home">
        <span class="brand-mark">S</span>
        <span>stillroom</span>
      </a>
      <section class="auth-card">
        <div class="eyebrow">MAKE ROOM FOR WHAT MATTERS</div>
        <h1>Create your space</h1>
        <p class="muted">Your images, together in one private place.</p>
        <% if (error) { %>
          <div class="form-error" role="alert"><%= error %></div>
        <% } %>
        <form action="/signup" method="post" class="form-stack">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" value="<%= name %>" maxlength="100" placeholder="Alex Morgan" required>
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" autocomplete="email" value="<%= email %>" maxlength="254" placeholder="you@example.com" required>
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="72" placeholder="At least 12 characters" required>
          <button class="button button-primary button-wide" type="submit">Create account <span aria-hidden="true">→</span></button>
        </form>
        <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
      </section>
      <p class="auth-note">A calm place for the images you want to keep.</p>
    </main>
  </body>
</html>
